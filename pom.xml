<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.net.silvioluizsilva</groupId>
        <artifactId>pluginbase-build-parent</artifactId>
        <version>0.0.1</version>
        <relativePath/>
    </parent>

    <artifactId>pluginexample</artifactId>
    <packaging>jar</packaging>

    <name>PluginExample</name>
    <description>Plugin consumidor de exemplo para o PluginBase.</description>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - MinecraftPluginExample</name>
            <url>https://maven.pkg.github.com/silvioluizsilva/MinecraftPluginExample</url>
        </repository>
    </distributionManagement>

    <properties>
        <paper.version>26.2.build.65-beta</paper.version>
        <pluginbase.version>0.0.1</pluginbase.version>
        <junit.version>5.13.4</junit.version>
        <mockito.version>5.20.0</mockito.version>
    </properties>

    <repositories>
        <repository>
            <id>github-pluginbase</id>
            <url>https://maven.pkg.github.com/silvioluizsilva/MinecraftPluginBase</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>br.net.silvioluizsilva</groupId>
            <artifactId>pluginbase</artifactId>
            <version>${pluginbase.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource><directory>src/main/resources</directory><filtering>true</filtering></resource>
        </resources>
    </build>
</project>
